---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const projectIcons = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/projects/**/icon.png",
  { eager: true },
);
const projectPath = Astro.url.pathname.split("/").filter(Boolean).slice(1, 3).join("/");
const icon = projectIcons[`../assets/projects/${projectPath}/icon.png`]?.default;
const hasIcon = icon !== undefined;
---

<h1 id="_top" class:list={{ "project-page-title": hasIcon }}>
  {icon && <Image src={icon} alt="" width={64} height={64} />}
  {Astro.locals.starlightRoute.entry.data.title}
</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    .project-page-title {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .project-page-title :global(img) {
      flex: 0 0 auto;
      border-radius: 10px;
      image-rendering: pixelated;
    }
  }
</style>
